<?xml version="1.0"?>
<!-- mechdog_gazebo.xacro – Included by mechdog.urdf.xacro when simulation:=true
     Usage in main URDF:
       <xacro:include filename="$(find mechdog_description)/urdf/mechdog_gazebo.xacro"/>
       <xacro:mechdog_gazebo_extensions prefix="" simulation="$(arg simulation)"/> -->
<xacro:macro xmlns:xacro="http://www.ros.org/wiki/xacro" name="mechdog_gazebo_extensions" params="prefix simulation:=false">
  <xacro:if value="${simulation}">
    <gazebo reference="${prefix}base_link">
      <material>Gazebo/Blue</material>
      <mu1>0.02</mu1>
      <mu2>0.02</mu2>
    </gazebo>

    <gazebo reference="${prefix}ultrasonic_link">
      <material>Gazebo/Red</material>
    </gazebo>

    <!-- Ground-truth Odometry (P3D) -->
    <gazebo>
      <plugin name="gazebo_ros_ground_truth_odom" filename="libgazebo_ros_p3d.so">
        <bodyName>${prefix}base_link</bodyName>
        <topicName>/gazebo/odom_clean</topicName>
        <frameName>world</frameName>
        <xyzOffsets>0 0 0</xyzOffsets>
        <rpyOffsets>0 0 0</rpyOffsets>
        <updateRate>50.0</updateRate>
        <gaussianNoise>0.0</gaussianNoise>
      </plugin>
    </gazebo>

    <!-- Ultrasonic Range Sensor (HC-SR04 emulation) -->
    <gazebo reference="${prefix}ultrasonic_link">
      <sensor type="ray" name="ultrasonic_sensor">
        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>-0.13</min_angle>
              <max_angle>0.13</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.02</min>
            <max>3.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </ray>
        <plugin name="ultrasonic_range_controller" filename="libgazebo_ros_range.so">
          <topicName>/gazebo/ultrasonic_clean</topicName>
          <frameName>${prefix}ultrasonic_link</frameName>
          <radiationType>ultrasonic</radiationType>
          <fov>0.26</fov>
          <minDistance>0.02</minDistance>
          <maxDistance>3.0</maxDistance>
          <gaussianNoise>0.005</gaussianNoise>
          <updateRate>20</updateRate>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:if>
</xacro:macro>
