<?xml version="1.0"?>
<robot name="mechdog" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="simulation" default="false"/>

  <!-- Robot Properties -->
  <xacro:property name="robot_length" value="0.5"/>
  <xacro:property name="robot_width" value="0.3"/>
  <xacro:property name="robot_height" value="0.2"/>
  <xacro:property name="robot_mass" value="2.0"/>
  
  <!-- Sensor Offsets — Ultrasonic at front-center, past the legs -->
  <xacro:property name="ultrasonic_offset_x" value="0.28"/>
  <xacro:property name="ultrasonic_offset_z" value="0.15"/>
  <xacro:property name="ultrasonic_fov" value="0.26"/>
  <xacro:property name="ultrasonic_min_range" value="0.02"/>
  <xacro:property name="ultrasonic_max_range" value="3.0"/>
  
  <!-- Velocity Limits -->
  <xacro:property name="max_velocity" value="1.0"/>
  <xacro:property name="max_angular_velocity" value="1.5"/>

  <!-- Materials -->
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  <material name="gray">
    <color rgba="0.8 0.8 0.8 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <!-- Base Link (main body) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${robot_length} ${robot_width} ${robot_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${robot_length} ${robot_width} ${robot_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${robot_mass}"/>
      <origin xyz="0 0 0" />
      <inertia  ixx="${robot_mass * (robot_length*robot_length + robot_width*robot_width) / 12.0}"
                ixy="0.0"  ixz="0.0"
                iyy="${robot_mass * (robot_width*robot_width + robot_height*robot_height) / 12.0}"
                iyz="0.0"  izz="${robot_mass * (robot_length*robot_length + robot_height*robot_height) / 12.0}"/>
    </inertial>
  </link>

  <!-- Base Footprint (for navigation) -->
  <link name="base_footprint">
  </link>

  <!-- Static transform between base_footprint and base_link -->
  <joint name="base_footprint_base_link" type="fixed">
    <origin xyz="0 0 ${robot_height/2}" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- Ultrasonic Sensor (HC-SR04 equivalent) -->
  <link name="ultrasonic_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" />
      <inertia  ixx="0.00001" ixy="0.0" ixz="0.0"
                iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- Static transform from base_link to ultrasonic_link -->
  <joint name="base_link_ultrasonic_link" type="fixed">
    <origin xyz="${ultrasonic_offset_x} 0 ${ultrasonic_offset_z}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="ultrasonic_link"/>
  </joint>

  <!-- Simplified Leg Links (for visualization) -->
  <!-- Front Left Leg -->
  <link name="leg_front_left">
    <visual>
      <geometry>
        <cylinder length="0.15" radius="0.03"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.15" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Front Right Leg -->
  <link name="leg_front_right">
    <visual>
      <geometry>
        <cylinder length="0.15" radius="0.03"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.15" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Rear Left Leg -->
  <link name="leg_rear_left">
    <visual>
      <geometry>
        <cylinder length="0.15" radius="0.03"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.15" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Rear Right Leg -->
  <link name="leg_rear_right">
    <visual>
      <geometry>
        <cylinder length="0.15" radius="0.03"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.15" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Leg Joints (fixed for now, could be made movable later) -->
  <!-- Front Left -->
  <joint name="base_link_leg_front_left" type="fixed">
    <origin xyz="${robot_length/2} ${robot_width/2} 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="leg_front_left"/>
  </joint>

  <!-- Front Right -->
  <joint name="base_link_leg_front_right" type="fixed">
    <origin xyz="${robot_length/2} -${robot_width/2} 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="leg_front_right"/>
  </joint>

  <!-- Rear Left -->
  <joint name="base_link_leg_rear_left" type="fixed">
    <origin xyz="-${robot_length/2} ${robot_width/2} 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="leg_rear_left"/>
  </joint>

  <!-- Rear Right -->
  <joint name="base_link_leg_rear_right" type="fixed">
    <origin xyz="-${robot_length/2} -${robot_width/2} 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="leg_rear_right"/>
  </joint>

  <!-- Simulation-only plugins (Gazebo) -->
  <xacro:if value="$(arg simulation)">
    <!-- Ground-truth Odometry Plugin (P3D) -->
    <gazebo>
      <plugin name="gazebo_ros_ground_truth_odom" filename="libgazebo_ros_p3d.so">
        <bodyName>base_link</bodyName>
        <topicName>/gazebo/odom_clean</topicName>
        <frameName>world</frameName>
        <xyzOffsets>0 0 0</xyzOffsets>
        <rpyOffsets>0 0 0</rpyOffsets>
        <updateRate>50.0</updateRate>
        <gaussianNoise>0.0</gaussianNoise>
      </plugin>
    </gazebo>

    <!-- Ultrasonic Range Sensor (HC-SR04 emulation)
         Topic: /gazebo/ultrasonic_clean  (sensor_msgs/Range)
         Max range: 3.0 m, FOV: 0.26 rad (15°), Rate: 20 Hz -->
    <gazebo reference="ultrasonic_link">
      <sensor type="ray" name="ultrasonic_sensor">
        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>-0.13</min_angle>
              <max_angle>0.13</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.02</min>
            <max>3.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </ray>
        <plugin name="ultrasonic_range_controller" filename="libgazebo_ros_range.so">
          <topicName>/gazebo/ultrasonic_clean</topicName>
          <frameName>ultrasonic_link</frameName>
          <radiationType>ultrasonic</radiationType>
          <fov>0.26</fov>
          <minDistance>0.02</minDistance>
          <maxDistance>3.0</maxDistance>
          <gaussianNoise>0.005</gaussianNoise>
          <updateRate>20</updateRate>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:if>

</robot>